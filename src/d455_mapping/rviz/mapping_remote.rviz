# Generated by tools/gen_rviz.py -- edit that file, not this one.
Panels:
- Class: rviz_common/Displays
  Name: Displays
  Help Height: 0
  Tree Height: 600
- Class: rviz_common/Views
  Name: Views
- Class: rviz_common/Time
  Name: Time
  SyncMode: 0
  SyncSource: ''
Visualization Manager:
  Class: ''
  Name: root
  Enabled: true
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Reference Frame: <Fixed Frame>
    Plane: XY
    Cell Size: 1
    Plane Cell Count: 20
    Color: 160; 160; 164
    Alpha: 0.5
    Value: true
  - Class: rviz_default_plugins/TF
    Name: TF
    Enabled: true
    Show Names: true
    Show Axes: true
    Show Arrows: false
    Marker Scale: 0.3
    Update Interval: 0
    Frame Timeout: 15
    Value: true
    Frames:
      All Enabled: false
      map:
        Value: true
      odom:
        Value: true
      base_link:
        Value: true
      camera_link:
        Value: true
      camera_color_optical_frame:
        Value: true
  - Class: rviz_default_plugins/Image
    Name: Color (compressed)
    Enabled: true
    Topic:
      Value: /camera/color/image_raw/compressed
      Depth: 1
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Durability Policy: Volatile
    Normalize Range: true
    Max Value: 1
    Min Value: 0
    Median window: 5
    Value: true
  - Class: rviz_default_plugins/Path
    Name: cuVSLAM odom path
    Enabled: true
    Topic:
      Value: /visual_slam/tracking/vo_path
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
    Color: 255; 170; 0
    Line Style: Lines
    Line Width: 0.03
    Alpha: 1
    Buffer Length: 1
    Pose Style: None
    Value: true
  - Class: rviz_default_plugins/Path
    Name: RTAB-Map path
    Enabled: true
    Topic:
      Value: /rtabmap/mapPath
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
    Color: 0; 255; 255
    Line Style: Lines
    Line Width: 0.03
    Alpha: 1
    Buffer Length: 1
    Pose Style: None
    Value: true
  - Class: rtabmap_rviz_plugins/MapGraph
    Name: RTAB-Map Graph
    Enabled: true
    Topic:
      Value: /rtabmap/mapGraph
      Depth: 1
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
    Alpha: 1
    Color: 0; 255; 0
    Value: true
  - Class: rtabmap_rviz_plugins/MapCloud
    Name: RTAB-Map MapCloud
    Enabled: false
    Topic:
      Value: /rtabmap/mapData
      Depth: 1
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
    Cloud decimation: 8
    Cloud max depth (m): 3.0
    Cloud min depth (m): 0
    Cloud voxel size (m): 0.02
    Filter floor (m): 0
    Filter ceiling (m): 0
    Node filtering radius (m): 0
    Style: Points
    Size (Pixels): 2
    Size (m): 0.01
    Alpha: 1
    Color Transformer: RGB8
    Position Transformer: XYZ
    Download map: false
    Download graph: false
    Value: false
  - Class: nvblox_rviz_plugin/NvbloxMesh
    Name: nvblox Mesh
    Enabled: true
    Cut Ceiling: false
    Topic:
      Value: /nvblox_node/mesh
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
      Filter size: 10
    Value: true
  - Class: nvblox_rviz_plugin/NvbloxVoxelBlockLayer
    Name: nvblox Color Voxels
    Enabled: false
    Cut Ceiling: false
    Topic:
      Value: /nvblox_node/color_layer
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
      Filter size: 10
    Value: false
  - Class: rviz_default_plugins/MarkerArray
    Name: Crosses (live)
    Enabled: true
    Topic:
      Value: /cross_detector/live_markers
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
    Namespaces: {}
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Name: Crosses (landmarks)
    Enabled: true
    Topic:
      Value: /cross_detector/landmarks
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
    Namespaces: {}
    Value: true
  - Class: rviz_default_plugins/Image
    Name: Cross debug image
    Enabled: false
    Topic:
      Value: /cross_detector/debug_image
      Depth: 1
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Durability Policy: Volatile
    Normalize Range: true
    Max Value: 1
    Min Value: 0
    Median window: 5
    Value: false
  - Class: rviz_default_plugins/MarkerArray
    Name: Pins and distances
    Enabled: true
    Topic:
      Value: /pins/markers
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
    Namespaces: {}
    Value: true
  Global Options:
    Fixed Frame: map
    Background Color: 48; 48; 48
    Frame Rate: 30
  Tools:
  - Class: rviz_default_plugins/Interact
    Hide Inactive Objects: true
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/PublishPoint
    Single click: true
    Topic:
      Value: /clicked_point
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
  - Class: rviz_default_plugins/FocusCamera
  - Class: rviz_default_plugins/Measure
    Line color: 128; 128; 0
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: <Fixed Frame>
      Distance: 8.0
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 0.0
      Pitch: 0.7
      Yaw: 3.6
      Near Clip Distance: 0.01
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Value: Orbit (rviz)
    Saved: null
Window Geometry:
  Width: 1600
  Height: 1000
  Hide Left Dock: false
  Hide Right Dock: true
  X: 0
  Y: 0
