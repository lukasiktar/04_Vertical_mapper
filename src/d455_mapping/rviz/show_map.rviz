# Generated by tools/gen_rviz.py -- edit that file, not this one.
Panels:
- Class: rviz_common/Displays
  Name: Displays
  Help Height: 0
  Tree Height: 600
- Class: rviz_common/Views
  Name: Views
- Class: rviz_common/Time
  Name: Time
  SyncMode: 0
  SyncSource: ''
Visualization Manager:
  Class: ''
  Name: root
  Enabled: true
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Reference Frame: <Fixed Frame>
    Plane: XY
    Cell Size: 1
    Plane Cell Count: 20
    Color: 160; 160; 164
    Alpha: 0.5
    Value: true
  - Class: rviz_default_plugins/TF
    Name: TF
    Enabled: true
    Show Names: true
    Show Axes: true
    Show Arrows: false
    Marker Scale: 0.3
    Update Interval: 0
    Frame Timeout: 15
    Value: true
    Frames:
      All Enabled: false
      map:
        Value: true
      odom:
        Value: true
      base_link:
        Value: true
      camera_link:
        Value: true
      camera_color_optical_frame:
        Value: true
  - Class: rviz_default_plugins/PointCloud2
    Name: Prior map
    Enabled: true
    Topic:
      Value: /prior_map
      Depth: 1
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Transient Local
    Style: Points
    Size (Pixels): 2
    Size (m): 0.02
    Alpha: 1
    Decay Time: 0
    Color Transformer: RGB8
    Position Transformer: XYZ
    Use Fixed Frame: true
    Value: true
  - Class: rviz_default_plugins/Marker
    Name: Prior map mesh
    Enabled: true
    Topic:
      Value: /prior_map_mesh
      Depth: 1
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Transient Local
    Namespaces: {}
    Value: true
  Global Options:
    Fixed Frame: map
    Background Color: 48; 48; 48
    Frame Rate: 30
  Tools:
  - Class: rviz_default_plugins/Interact
    Hide Inactive Objects: true
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/PublishPoint
    Single click: true
    Topic:
      Value: /clicked_point
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
  - Class: rviz_default_plugins/FocusCamera
  - Class: rviz_default_plugins/Measure
    Line color: 128; 128; 0
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: <Fixed Frame>
      Distance: 8.0
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 0.0
      Pitch: 0.7
      Yaw: 3.6
      Near Clip Distance: 0.01
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Value: Orbit (rviz)
    Saved: null
Window Geometry:
  Width: 1600
  Height: 1000
  Hide Left Dock: false
  Hide Right Dock: true
  X: 0
  Y: 0
