@@ -39,6 +39,14 @@
     .keep_last(kOutputQueueSize);
   const rmw_qos_profile_t input_qos_profile = input_qos.get_rmw_qos_profile();
 
+  // d455_mapping patch: some D455 firmware / librealsense combinations (e.g. FW 5.15.1.55 with
